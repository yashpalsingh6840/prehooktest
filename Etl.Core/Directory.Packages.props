<Project>
  <!--
    Scoped to just this Etl.Core copy, see Directory.Build.props in this same directory for why
    (must not leak into Tools/SsisExtractor's own, non-CPM, explicit-Version PackageReferences).

    Versions mirror GenerateCommand.WriteFixedFiles' own emitted Directory.Packages.props.
    Keep the two in sync.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="AWSSDK.S3" Version="4.0.104.1" />
    <!-- Transitive via AWSSDK.S3; pinned explicitly, since NuGet's own vulnerability audit
         (NU1902/NU1903, an error under this project's TreatWarningsAsErrors) flags whatever
         version floats in otherwise. Real advisories GHSA-2fmv-rv2c-59x7 (moderate) and
         GHSA-846f-f764-76mx (high), both a SignedCms.CheckSignature DoS, fixed in 10.0.13 for the
         10.x line (this copy targets net10.0 only; see GenerateCommand.SecurityCryptographyPkcsVersionFor
         for the net8.0-targeted generated-output equivalent, pinned at 8.0.2 there). Keep the two
         in sync. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageVersion Include="CsvHelper" Version="33.1.0" />
    <PackageVersion Include="ExcelDataReader" Version="3.7.0" />
    <PackageVersion Include="MailKit" Version="4.17.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.11" />
    <PackageVersion Include="System.Text.Encoding.CodePages" Version="10.0.11" />
  </ItemGroup>
</Project>
