<Project Sdk="Microsoft.NET.Sdk">

  <!--
    In SSIS.sln, mapped to "Release|Any CPU" under that solution's custom
    "Default" platform. That mapping is load-bearing: devenv silently SKIPS a
    project cross-mapped to a real platform like x64 under the Default-only
    platform an SSDT dtproj forces (see CLAUDE.md trap 6). Unlike
    PkgRun.Console this project has no PlatformTarget of its own (pure
    managed code, no dependency on the x64-only DTSRuntimeWrap), so AnyCPU
    is both the label and the truth here.

    Builds either way:

        dotnet build Scripts\SsisRunner\SsisRunner.csproj -c Release

    net8.0 is chosen over net10.0 because it is the LTS release and the
    intended host is an OpenShift container image. The .NET 8 runtime is
    present on this machine alongside 9 and 10.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SsisRunner</AssemblyName>
    <RootNamespace>SsisRunner</RootNamespace>
    <!-- InvariantGlobalization must stay off: Microsoft.Data.SqlClient throws
         "Globalization Invariant Mode is not supported" at startup under it. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
  </ItemGroup>

  <ItemGroup>
    <None Update="manifests\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
