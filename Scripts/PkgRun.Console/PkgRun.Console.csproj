<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Standalone console front-end for Scripts/PkgRun.cs (shared with
    Scripts/Run-Package.ps1 via a linked Compile item, so the execution
    logic lives in exactly one place).

    Targets classic .NET Framework, not .NET/Core: Microsoft.SqlServer.
    ManagedDTS et al. are GAC-only assemblies that ship with SQL Server /
    SSDT and are not available for modern .NET. Must run as x64: the
    DTSRuntimeWrap assembly is GAC_64 (platform-specific), not GAC_MSIL.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <AssemblyName>PkgRun.Console</AssemblyName>
    <RootNamespace>PkgRunConsole</RootNamespace>
    <Nullable>disable</Nullable>
    <LangVersion>7.3</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- shared execution logic, also used by Run-Package.ps1 -->
    <Compile Include="..\PkgRun.cs" Link="PkgRun.cs" />
  </ItemGroup>

  <!--
    ManagedDTS / DTSPipelineWrap / DTSRuntimeWrap come from the GAC (installed
    by SSDT / SQL Server). Build/Ssis.Gac.props detects which SSIS version is
    installed rather than pinning one - see that file's header for why a
    pinned HintPath breaks on a new machine, and for how to pin deliberately.
  -->
  <Import Project="..\..\Build\Ssis.Gac.props" />

</Project>
