<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Standalone console front-end for Scripts/PkgRun.cs (shared with
    Scripts/Run-Package.ps1 via a linked Compile item, so the execution
    logic lives in exactly one place).

    Targets classic .NET Framework, not .NET/Core: Microsoft.SqlServer.
    ManagedDTS et al. are GAC-only assemblies that ship with SQL Server /
    SSDT and are not available for modern .NET. Must run as x64: the
    DTSRuntimeWrap assembly is GAC_64 (platform-specific), not GAC_MSIL.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <AssemblyName>PkgRun.Console</AssemblyName>
    <RootNamespace>PkgRunConsole</RootNamespace>
    <Nullable>disable</Nullable>
    <LangVersion>7.3</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- shared execution logic, also used by Run-Package.ps1 -->
    <Compile Include="..\PkgRun.cs" Link="PkgRun.cs" />
  </ItemGroup>

  <ItemGroup>
    <!--
      These three come from the GAC (installed by SSDT / SQL Server, version
      17.0.0.0, PublicKeyToken 89845dcd8080cc91). HintPath below matches this
      machine; Private=False means they're resolved from the GAC at runtime
      too (not copied next to the exe), same as dtexec/devenv do it. If you
      build this on a different machine, re-resolve the paths with:
        [System.Reflection.Assembly]::LoadWithPartialName('Microsoft.SqlServer.ManagedDTS').Location
    -->
    <Reference Include="Microsoft.SqlServer.ManagedDTS">
      <HintPath>C:\WINDOWS\Microsoft.Net\assembly\GAC_MSIL\Microsoft.SqlServer.ManagedDTS\v4.0_17.0.0.0__89845dcd8080cc91\Microsoft.SqlServer.ManagedDTS.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Microsoft.SqlServer.DTSPipelineWrap">
      <HintPath>C:\WINDOWS\Microsoft.Net\assembly\GAC_MSIL\Microsoft.SqlServer.DTSPipelineWrap\v4.0_17.0.0.0__89845dcd8080cc91\Microsoft.SqlServer.DTSPipelineWrap.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Microsoft.SqlServer.DTSRuntimeWrap">
      <HintPath>C:\WINDOWS\Microsoft.Net\assembly\GAC_64\Microsoft.SqlServer.DTSRuntimeWrap\v4.0_17.0.0.0__89845dcd8080cc91\Microsoft.SqlServer.DTSRuntimeWrap.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

</Project>
