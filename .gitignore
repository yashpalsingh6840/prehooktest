# Build outputs (SSIS project + every .NET project under Scripts/)
[Bb]in/
[Oo]bj/

# Visual Studio / SSDT local state and per-user project options
.vs/
*.user
*.suo

# SSIS deployment-wizard output report (timestamped per run, not source)
deploysummary_*.xml

# svk (SsisValidationKit) demo output at the repo root -- regenerated on demand by
# running `svk` against this PoC's own packages, disposable like every other `out`
# folder in this project (Tools/out, Validation output, etc.).
/Out/

# Python bytecode cache for Tools/ssis_connection_scan.py
__pycache__/
*.pyc

# Claude Code local session/permission state -- accumulates machine-specific
# paths and references to ephemeral per-session temp/scratchpad directories,
# not meant to be shared as project config. Narrowed (not a blanket .claude/
# exclude) so that .claude/skills/ -- deliberate, shareable project context
# meant to persist across sessions -- still gets tracked.
.claude/settings.json
.claude/settings.local.json

# OS cruft
Thumbs.db
.DS_Store

# Client-delivery packaging artifacts -- a ~32MB zip plus its 4MB split parts,
# regenerated by Publish-Survey.ps1 on demand. Committed once in c8bf74d and
# removed again; ignored here so a re-run doesn't re-add ~64MB of binaries.
Tools/SsisExtractor/scripts-for-client.zip
Tools/SsisExtractor/scripts-for-client-parts/
