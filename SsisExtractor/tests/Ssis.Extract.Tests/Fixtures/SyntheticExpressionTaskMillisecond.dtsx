    <DTS:Executable
      DTS:refId="Package\EXPR_ObserveMs"
      DTS:CreationName="Microsoft.ExpressionTask"
      DTS:DTSID="{68B6F72F-450E-4CF2-85BA-8CF131B82CAF}"
      DTS:ExecutableType="Microsoft.ExpressionTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="EXPR_ObserveMs"
      DTS:TaskContact="Expression Task;Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <ExpressionTask
          Expression="@[User::MsAfterTrim] = DATEPART(&quot;Millisecond&quot;, @[User::TargetETLCutoffTime])" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\EXPR_SetMs789"
      DTS:CreationName="Microsoft.ExpressionTask"
      DTS:DTSID="{DFAD818E-53B8-4610-950D-A707DC32836E}"
      DTS:ExecutableType="Microsoft.ExpressionTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="EXPR_SetMs789"
      DTS:TaskContact="Expression Task;Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <ExpressionTask
          Expression="@[User::TargetETLCutoffTime] = DATEADD(&quot;Millisecond&quot;, 789, @[User::TargetETLCutoffTime])" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\EXPR_TrimMilliseconds"
      DTS:CreationName="Microsoft.ExpressionTask"
      DTS:DTSID="{57703E53-B464-4D46-9823-DC764D58A8A7}"
      DTS:ExecutableType="Microsoft.ExpressionTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="EXPR_TrimMilliseconds"
      DTS:TaskContact="Expression Task;Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <ExpressionTask
          Expression="@[User::TargetETLCutoffTime] = DATEADD(&quot;Millisecond&quot;, 0 - DATEPART(&quot;Millisecond&quot;, @[User::TargetETLCutoffTime]), @[User::TargetETLCutoffTime])" />
      </DTS:ObjectData>
    </DTS:Executable>
