    <DTS:Executable
      DTS:refId="Package\SQL_AtomicSwap"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Atomic BEGIN TRAN / TRY / COMMIT / CATCH ROLLBACK, as MarginReport does"
      DTS:DTSID="{ED2BBCF5-594F-41FC-BE0A-12379AD92BB4}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_AtomicSwap"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{E5BB63DC-9A93-417B-B7A5-0C337CA34F0D}"
          SQLTask:SqlStatementSource="&#xA;BEGIN TRANSACTION [Tran1];&#xA;BEGIN TRY&#xA;    TRUNCATE TABLE dbo.CustomerFixedImport;&#xA;    COMMIT TRANSACTION [Tran1];&#xA;END TRY&#xA;BEGIN CATCH&#xA;    ROLLBACK TRANSACTION [Tran1];&#xA;END CATCH" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
