      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{034991FB-0BC3-4377-BF3D-2E2274CC650A}"
          SQLTask:SqlStatementSource="INSERT INTO dbo.EtlRunLog (PackageName, SourceName, EventType, MessageText)&#xA;VALUES (N'RBC_Demo_ETL', N'DFT_LoadCustomers', N'OnFailure',&#xA;        N'Customer load failed - staging may be incomplete.');" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
