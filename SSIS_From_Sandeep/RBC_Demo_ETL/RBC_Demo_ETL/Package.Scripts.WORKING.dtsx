            <component
              refId="Package\DFT_LoadCustomers\SCR_CleanseCustomerRow"
              componentClassID="Microsoft.ManagedComponentHost"
              contactInfo="Includes and runs custom script code.;Microsoft Corporation; Microsoft SQL Server; Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;13"
              description="Includes and runs custom script code."
              name="SCR_CleanseCustomerRow"
              version="13">
              <properties>
                <property
                  dataType="System.String"
                  description="Stores the source code of the component"
                  isArray="true"
                  name="SourceCode"
                  state="cdata">
                  <arrayElements
                    arrayElementCount="30">
                    <arrayElement
                      dataType="System.String"><![CDATA[ComponentWrapper.cs]]></arrayElement>
                    <arrayElement
                      dataType="System.String"><![CDATA[UTF8]]></arrayElement>
                    <arrayElement
                      dataType="System.String"><![CDATA[using System;
using Microsoft.SqlServer.Dts.Pipeline;
using Microsoft.SqlServer.Dts.Pipeline.Wrapper;

namespace SC_CleanseCustomerRow
{
    /// <summary>
    /// Mirrors the ComponentWrapper.cs that VSTA generates. The host calls the
    /// four-argument ProcessInput; this wraps the raw PipelineBuffer in the typed
    /// Input0Buffer and drives one call to Input0_ProcessInputRow per row.
    /// </summary>
    public class UserComponent : ScriptComponent
    {
        public override void ProcessInput(int InputID, string InputName, PipelineBuffer Buffer, OutputNameMap OutputMap)
        {
            Input0Buffer Row = new Input0Buffer(Buffer, GetColumnIndexes(InputID), OutputMap);

            while (Row.NextRow())
            {
                Input0_ProcessInputRow(Row);
            }

            if (Row.EndOfRowset())
            {
                Input0_ProcessInput(Row);
            }
        }

        public virtual void Input0_ProcessInputRow(Input0Buffer Row) { }

        public virtual void Input0_ProcessInput(Input0Buffer Buffer) { }
    }
}
]]></arrayElement>
