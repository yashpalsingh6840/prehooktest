                      name="Expression">![ISNULL](#{Package\DFT_DerivedAndSplit\DCONV_Types.Outputs[Data Conversion Output].Columns[CustomerID_i4]}) &amp;&amp; [FINDSTRING]([TRIM](#{Package\DFT_DerivedAndSplit\FF_SRC_Customers.Outputs[Flat File Source Output].Columns[Email]}),"@",1) &gt; 0</property>
