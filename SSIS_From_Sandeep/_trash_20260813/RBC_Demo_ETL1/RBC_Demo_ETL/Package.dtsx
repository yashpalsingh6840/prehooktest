        DTS:DTSID="{AF338219-0976-4B46-B385-0C75BEB806FC}"
        DTS:ExecutableType="SSIS.Pipeline.2"
        DTS:LocaleID="-1"
        DTS:ObjectName="DFT - Build Sales Summary">
      <DTS:VariableDispenser />
      <DTS:ObjectData>
        <pipeline version="1">
          <components>

            <component
                refId="Package\DFT - Build Sales Summary\OLE SRC OrdersAndDetails"
                componentClassID="Microsoft.OLEDBSource"
                contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;5"
                description="OLE DB Source"
                name="OLE SRC OrdersAndDetails"
                usesDispositions="true"
                version="5">
              <properties>
                <property dataType="System.Int32" description="The number of seconds before a command times out." name="CommandTimeout">0</property>
                <property dataType="System.String" description="Specifies the name of the database object used to open a rowset." name="OpenRowset"></property>
                <property dataType="System.String" description="Specifies the variable that contains the name of the database object used to open a rowset." name="OpenRowsetVariable"></property>
                <property dataType="System.String" description="The SQL command to be executed." name="SqlCommand" UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor"><![CDATA[SELECT
    o.CustomerID,
    c.FullName,
    c.CleanEmail AS Email,
    COUNT(DISTINCT o.OrderID) AS TotalOrders,
    SUM(od.Quantity * od.UnitPrice) AS TotalRevenue,
    MAX(o.OrderDate) AS LastOrderDate
FROM dbo.Orders o
INNER JOIN dbo.OrderDetails od ON od.OrderID = o.OrderID
INNER JOIN dbo.StagingCustomers c ON o.CustomerID = TRY_CAST(c.CustomerID AS INT)
WHERE c.IsValidRow = 1
GROUP BY o.CustomerID, c.FullName, c.CleanEmail]]></property>
                <property dataType="System.Int32" description="Specifies the mode used to access the database." name="AccessMode" typeConverter="AccessMode">2</property>
              </properties>
