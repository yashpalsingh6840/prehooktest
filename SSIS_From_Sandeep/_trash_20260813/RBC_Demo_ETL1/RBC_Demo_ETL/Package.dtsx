                    <outputColumn refId="Package\DFT - Build Sales Summary\OLE SRC OrdersAndDetails.Outputs[OLE DB Source Output].Columns[TotalRevenue]" dataType="r8" lineageId="Package\DFT - Build Sales Summary\OLE SRC OrdersAndDetails.Outputs[OLE DB Source Output].Columns[TotalRevenue]" name="TotalRevenue" />
