<?xml version="1.0"?>
<SSIS:Parameters xmlns:SSIS="www.microsoft.com/SqlServer/SSIS">
  <SSIS:Parameter SSIS:Name="ServerName">
    <SSIS:Properties>
      <SSIS:Property SSIS:Name="ID">{D5F2237A-36F3-42C6-B772-CAB569F780C6}</SSIS:Property>
      <SSIS:Property SSIS:Name="CreationName"></SSIS:Property>
      <SSIS:Property SSIS:Name="Description">SQL Server host/port for the SSISDemo database (Docker default: localhost,1433).</SSIS:Property>
      <SSIS:Property SSIS:Name="IncludeInDebugDump">0</SSIS:Property>
      <SSIS:Property SSIS:Name="Required">0</SSIS:Property>
      <SSIS:Property SSIS:Name="Sensitive">0</SSIS:Property>
      <SSIS:Property SSIS:Name="DataType">18</SSIS:Property>
      <SSIS:Property SSIS:Name="Value">localhost,1433</SSIS:Property>
    </SSIS:Properties>
  </SSIS:Parameter>
  <SSIS:Parameter SSIS:Name="DatabaseName">
    <SSIS:Properties>
      <SSIS:Property SSIS:Name="ID">{8666CA7D-7729-4D26-826F-2BFDB75E5813}</SSIS:Property>
      <SSIS:Property SSIS:Name="CreationName"></SSIS:Property>
      <SSIS:Property SSIS:Name="Description">Target database name.</SSIS:Property>
      <SSIS:Property SSIS:Name="IncludeInDebugDump">0</SSIS:Property>
      <SSIS:Property SSIS:Name="Required">0</SSIS:Property>
      <SSIS:Property SSIS:Name="Sensitive">0</SSIS:Property>
      <SSIS:Property SSIS:Name="DataType">18</SSIS:Property>
      <SSIS:Property SSIS:Name="Value">SSISDemo</SSIS:Property>
    </SSIS:Properties>
  </SSIS:Parameter>
  <SSIS:Parameter SSIS:Name="SqlLogin">
    <SSIS:Properties>
      <SSIS:Property SSIS:Name="ID">{F95E9662-0EC9-4FAA-A904-1F451C158BFD}</SSIS:Property>
      <SSIS:Property SSIS:Name="CreationName"></SSIS:Property>
      <SSIS:Property SSIS:Name="Description">SQL authentication login.</SSIS:Property>
      <SSIS:Property SSIS:Name="IncludeInDebugDump">0</SSIS:Property>
      <SSIS:Property SSIS:Name="Required">0</SSIS:Property>
      <SSIS:Property SSIS:Name="Sensitive">0</SSIS:Property>
      <SSIS:Property SSIS:Name="DataType">18</SSIS:Property>
      <SSIS:Property SSIS:Name="Value">sa</SSIS:Property>
    </SSIS:Properties>
  </SSIS:Parameter>
  <SSIS:Parameter SSIS:Name="SqlPassword">
    <SSIS:Properties>
      <SSIS:Property SSIS:Name="ID">{2F8F3850-30D4-489F-8316-E123F99B392F}</SSIS:Property>
      <SSIS:Property SSIS:Name="CreationName"></SSIS:Property>
      <SSIS:Property SSIS:Name="Description">SQL authentication password. NOTE: kept as a plain (non-sensitive) parameter on purpose so this demo project runs without password re-entry after every open/clone. Never do this on a real project - use a Sensitive parameter plus an SSIS catalog Environment (or Key Vault) instead.</SSIS:Property>
      <SSIS:Property SSIS:Name="IncludeInDebugDump">0</SSIS:Property>
      <SSIS:Property SSIS:Name="Required">0</SSIS:Property>
      <SSIS:Property SSIS:Name="Sensitive">0</SSIS:Property>
      <SSIS:Property SSIS:Name="DataType">18</SSIS:Property>
      <SSIS:Property SSIS:Name="Value">YourStrong!Passw0rd123</SSIS:Property>
    </SSIS:Properties>
  </SSIS:Parameter>
  <SSIS:Parameter SSIS:Name="CsvFolderPath">
    <SSIS:Properties>
      <SSIS:Property SSIS:Name="ID">{B8E865F7-D41C-46AC-AC5B-ED20395A46FD}</SSIS:Property>
      <SSIS:Property SSIS:Name="CreationName"></SSIS:Property>
      <SSIS:Property SSIS:Name="Description">Folder containing Customers.csv.</SSIS:Property>
      <SSIS:Property SSIS:Name="IncludeInDebugDump">0</SSIS:Property>
      <SSIS:Property SSIS:Name="Required">0</SSIS:Property>
      <SSIS:Property SSIS:Name="Sensitive">0</SSIS:Property>
      <SSIS:Property SSIS:Name="DataType">18</SSIS:Property>
      <SSIS:Property SSIS:Name="Value">D:\OneDrive\OneDrive - Iris Software Inc\KT\RBC\SSIS\sample-data</SSIS:Property>
    </SSIS:Properties>
  </SSIS:Parameter>
</SSIS:Parameters>
