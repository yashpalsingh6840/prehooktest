<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- Microsoft.SqlServer.DTSRuntimeWrap is GAC_64 only (CLAUDE.md environment note),
         so anything referencing it must build/run as x64, not AnyCPU/x86. -->
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>ssis-expr-oracle</AssemblyName>
    <RootNamespace>Ssis.Expression.Oracle</RootNamespace>
  </PropertyGroup>

  <!--
    Windows-only, optional, and deliberately NOT referenced by Ssis.Runtime.Expressions.
    This is the oracle that produced tests/Ssis.Runtime.Expressions.Tests/Fixtures/
    ssis-expression-oracle.tsv: it evaluates each expression with the REAL SSIS expression
    evaluator so the semantics library encodes measured behaviour rather than remembered
    documentation. The library itself is net8.0 with no GAC dependency (plan §2.1); this
    project exists so the corpus can be REGENERATED and re-verified on a machine that has
    SSIS installed, not so the library needs one.

    GAC paths are this machine's (SSIS 17.0.0.0, PublicKeyToken 89845dcd8080cc91); resolve
    fresh on another machine via:
      [System.Reflection.Assembly]::LoadWithPartialName('Microsoft.SqlServer.ManagedDTS').Location
  -->
  <ItemGroup>
    <Reference Include="Microsoft.SqlServer.ManagedDTS">
      <HintPath>C:\WINDOWS\Microsoft.Net\assembly\GAC_MSIL\Microsoft.SqlServer.ManagedDTS\v4.0_17.0.0.0__89845dcd8080cc91\Microsoft.SqlServer.ManagedDTS.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.SqlServer.DTSRuntimeWrap">
      <HintPath>C:\WINDOWS\Microsoft.Net\assembly\GAC_64\Microsoft.SqlServer.DTSRuntimeWrap\v4.0_17.0.0.0__89845dcd8080cc91\Microsoft.SqlServer.DTSRuntimeWrap.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
