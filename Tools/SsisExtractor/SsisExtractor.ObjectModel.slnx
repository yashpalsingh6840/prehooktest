<Solution>
  <!--
    Deliberately separate from SsisExtractor.slnx: these two projects are Windows-only and
    need the SSIS 17 GAC assemblies installed (plan §7.3 test oracle), unlike the main
    solution's "works on any OS, no GAC" promise (plan §2.1). Build/test explicitly:
      dotnet build Tools/SsisExtractor/SsisExtractor.ObjectModel.slnx
      dotnet test  Tools/SsisExtractor/SsisExtractor.ObjectModel.slnx
  -->
  <Folder Name="/src/">
    <Project Path="src/Ssis.Extract.ObjectModel/Ssis.Extract.ObjectModel.csproj" />
  </Folder>
  <Folder Name="/tests/">
    <Project Path="tests/Ssis.Extract.ObjectModel.Tests/Ssis.Extract.ObjectModel.Tests.csproj" />
  </Folder>
</Solution>
